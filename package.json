{
  "name": "@etchteam/next-pagination",
  "version": "3.5.5",
  "description": "Pagination component for Next.js apps",
  "author": "etchteam",
  "license": "MIT",
  "repository": "etchteam/next-pagination",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.tsx",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "microbundle-crl --no-compress --format modern,cjs",
    "start": "microbundle-crl watch --no-compress --format modern,cjs",
    "prepare": "run-s build",
    "test": "run-s test:types test:unit",
    "test:unit": "cross-env CI=1 react-scripts test --env=jsdom",
    "test:watch": "react-scripts test --env=jsdom",
    "test:types": "tsc",
    "predeploy": "cd example && npm install && npm run build && touch build/.nojekyll",
    "deploy": "gh-pages -t -d example/build"
  },
  "peerDependencies": {
    "react": ">=16",
    "next": ">=10"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "lodash": "4.18.1",
    "query-string": "6.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@etchteam/stylelint-config": "^1.7.2",
    "@types/jest": "^27.5.0",
    "@types/lodash": "^4.14.182",
    "@types/node": "^17.0.31",
    "@types/react": "^18.0.8",
    "cross-env": "^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "gh-pages": "^5.0.0",
    "globals": "^17.14.0",
    "microbundle-crl": "^0.13.8",
    "next": "^16.1.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "sass": "1.26.5",
    "stylelint": "^16.26.1",
    "typescript": "^4.6.4",
    "typescript-eslint": "^8.72.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
